---
import { formatDate } from '../utils/date';

interface Props {
  id: string;
  title: string;
  description?: string;
  date: Date;
  tags: string[];
  cover?: string;
}

const { id, title, description, date, tags, cover } = Astro.props;

const formatted = formatDate(date);
---

<li class="post-card" data-tilt>
  <span class="post-card__glare" aria-hidden="true"></span>

  {
    cover ? (
      <div class="post-card__media">
        <img src={cover} alt="" loading="lazy" />
      </div>
    ) : (
      <div class="post-card__media post-card__media--empty">
        <span>no cover</span>
      </div>
    )
  }

  <div class="post-card__body">
    <time class="post-card__date" datetime={date.toISOString()}>{formatted}</time>

    <h3 class="post-card__title">
      <a href={`/post/${id}/`}>{title}</a>
    </h3>

    {description && <p class="post-card__desc">{description}</p>}

    <div class="post-card__tags">
      <ul class="tag-list">
        {
          tags.slice(0, 3).map((tag) => (
            <li>
              <span class="tag">{tag}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</li>
