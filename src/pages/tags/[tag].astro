---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tags.add(tag);
  }

  return [...tags].map((tag) => ({
    // 直接用标签名作为路径。含中文或空格的标签会被 Astro 自动编码，
    // 不影响可读性，也避免了维护一份额外的 slug 映射。
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的全部文章`}>
  <div class="page">
    <header class="page-header">
      <p class="page-header__eyebrow">
        <a href="/tags">← 全部标签</a>
      </p>
      <h1 class="page-header__title">{tag}</h1>
      <p class="page-header__desc">该标签下共 {posts.length} 篇文章。</p>
    </header>

    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-row">
            <a class="post-row__link" href={`/post/${post.id}/`}>
              <time class="post-row__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>

              <div>
                <h2 class="post-row__title">{post.data.title}</h2>
                {post.data.description && <p class="post-row__desc">{post.data.description}</p>}
                <ul class="tag-list">
                  {post.data.tags.map((t) => (
                    <li>
                      <span class:list={['tag', t === tag && 'tag--active']}>{t}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {post.data.cover ? (
                <div class="post-row__thumb">
                  <img src={post.data.cover} alt="" loading="lazy" />
                </div>
              ) : (
                <div class="post-row__thumb post-row__thumb--empty" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
